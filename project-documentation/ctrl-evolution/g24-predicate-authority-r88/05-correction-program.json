    "bind_every_receipt_to_exact_graph_epoch_seal_subject_case_purpose_and_audience",
    "bind_trigger_challenged_proof_dependency_use_and_affected_artifact_to_authoritative_graph_records",
    "require_exactly_one_terminal_receipt_per_closure_member",
    "require_history_preservation_and_descendant_block_evidence",
    "require_fresh_named_human_authority_before_any_reopen",
    "prove_no_affected_current_path_retains_superseded_steering_authority"
