{
  "schema_version": "ctrl.g24.predicate-authority.r81.semantic-set.v1",
  "module_id": "semantic_set_program",
  "profile_validation": {
    "schema_source": "imported_semantic_profile_schema",
    "additional_fields": "reject",
    "owner_binding_source": "imported_owner_registry",
    "content_fingerprint": "recompute_from_atomic_assertion_bytes",
    "validity": "applicable_from_less_than_or_equal_to_evaluation_time_strictly_less_than_valid_until",
    "accepted_brain_item": "requires_exact_item_ref_version_and_current_accepted_standing",
    "contrary_assertions": "must_resolve_and_disposition_must_match",
    "unregistered_dependency": "indeterminate"
  },
  "derivation_registry": [
    { "dependency_id": "all_dependencies_fresh", "function_id": "derive_all_dependency_validity_intersection", "version": "1", "input_fact_kinds": ["dependency_validity_boundaries"], "freshness": "minimum_input_valid_until", "non_widening": true },
    { "dependency_id": "checkpoint_integrity_valid", "function_id": "derive_checkpoint_integrity", "version": "1", "input_fact_kinds": ["current_checkpoint_version", "checkpoint_evidence_set"], "freshness": "minimum_input_valid_until", "non_widening": true },
    { "dependency_id": "every_obligation_fulfilled_or_recorded_outstanding", "function_id": "derive_close_obligation_disposition_completeness", "version": "1", "input_fact_kinds": ["complete_close_obligation_set", "obligation_dispositions"], "freshness": "minimum_input_valid_until", "non_widening": true },
    { "dependency_id": "fresh_issuance_exists_where_required", "function_id": "derive_required_grant_fresh_issuance", "version": "1", "input_fact_kinds": ["complete_current_grant_set", "grant_issuance_events"], "freshness": "minimum_input_valid_until", "non_widening": true },
    { "dependency_id": "no_old_grant_can_revive", "function_id": "derive_prior_grant_non_revival", "version": "1", "input_fact_kinds": ["complete_prior_grant_set", "complete_current_revocation_set"], "freshness": "minimum_input_valid_until", "non_widening": true },
    { "dependency_id": "old_expired_or_revoked_grants_unusable", "function_id": "derive_expired_revoked_grant_ineligibility", "version": "1", "input_fact_kinds": ["complete_current_grant_set", "complete_current_revocation_set"], "freshness": "minimum_input_valid_until", "non_widening": true },
    { "dependency_id": "subject_and_case_identities_exact", "function_id": "derive_subject_case_identity_binding", "version": "1", "input_fact_kinds": ["current_subject_identity_binding", "current_case_identity_binding"], "freshness": "minimum_input_valid_until", "non_widening": true }
  ],
  "derived_profile_rules": [
    "registered_dependency_function_and_version_exact",
    "input_receipt_set_complete_and_content_addressed",
    "output_subject_case_purpose_equal_inputs",
    "output_audience_is_intersection_of_inputs",
    "output_allowed_uses_is_intersection_of_inputs",
    "output_consequence_not_wider_than_inputs",
    "output_valid_until_equals_minimum_input_valid_until"
  ],
  "derived_fact_proof_required": ["dependency_id", "function_id", "function_version", "input_receipts", "input_set_seal", "output_profile_fingerprint", "proof_fingerprint"],
  "derived_input_required": ["fact_kind", "receipt_fingerprint", "subject_id", "case_id", "purpose_id", "permitted_audience", "allowed_uses", "consequence_class", "valid_until"],
  "predicate_proof_required": ["proof_id", "transition_id", "conditional_context", "expected_dependency_ids", "expected_dependency_set_seal", "dependency_results", "evaluation_time", "subject_id", "case_id", "purpose_id", "permitted_audience", "authority_bundle_fingerprint", "proof_fingerprint"],
  "dependency_result_required": ["dependency_id", "disposition", "evidence_ref", "evidence_fingerprint"],
  "disposition_classes": { "present": "present", "contradicted": "contradicted", "missing": "indeterminate", "stale": "indeterminate", "unreadable": "indeterminate", "ambiguous": "indeterminate", "revoked": "indeterminate" },
  "precedence": ["indeterminate", "contradicted", "present"],
  "class_to_result": { "indeterminate": "indeterminate", "contradicted": "unsatisfied", "present": "satisfied" },
  "complete_set_rules": [
    "derive_required_server_and_normative_ids_from_exact_transition",
    "materialize_conditional_dependency_ids_from_conditional_context",
    "canonical_sort_and_seal_exact_required_dependency_ids",
    "reject_missing_extra_duplicate_or_unknown_dependency_result",
    "resolve_every_server_profile_or_normative_receipt",
    "reject_empty_required_set",
    "aggregate_only_after_exact_set_and_evidence_validation"
  ],
  "proof_may_apply_transition": false
}
