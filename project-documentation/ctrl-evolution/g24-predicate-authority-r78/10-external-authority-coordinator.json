{
  "schema_version": "ctrl.g24.predicate-authority.r78.module.v1",
  "module_id": "external_authority_coordinator",
  "responsibility": "Prove commit-time authority for exact external canonical facts without pretending a local transaction can lock another system.",
  "forbidden": [
    "generic_signed_true",
    "dynamic_protocol_choice",
    "dynamic_owner_choice",
    "key_revocation_as_fact_revocation_substitute",
    "local_lock_claim_over_external_state",
    "steering_from_non_final_state"
  ],
  "protocols": [
    {
      "protocol_id": "immutable_authority_lease",
      "allowed_only_when": "issuer_guarantees_exact_fact_revision_cannot_be_withdrawn_before_valid_until",
      "required_bindings": [
        "assertion_id",
        "fact_kind",
        "fact_revision",
        "source_head",
        "fact_revocation_epoch",
        "issuer_key_id",
        "issuer_policy_version",
        "verification_time",
        "valid_until",
        "maximum_clock_skew",
        "reservation_id",
        "transaction_nonce",
        "transition_id",
        "visible_consequence_fingerprint"
      ],
      "forbidden_fact_kinds": [
        "current_human_consent",
        "current_human_permission"
      ],
      "historical_event_limit": "completed_signature_envelope_proves_only_historical_completion"
    },
    {
      "protocol_id": "online_conditional_verify_and_consume",
      "allowed_only_when": "issuer_atomically_verifies_or_consumes_exact_current_assertion",
      "required_bindings": [
        "assertion_id",
        "fact_kind",
        "fact_revision",
        "source_head",
        "fact_revocation_epoch",
        "issuer_key_id",
        "issuer_policy_version",
        "verification_time",
        "valid_until",
        "maximum_clock_skew",
        "reservation_id",
        "reserved_receipt_version",
        "transaction_nonce",
        "transition_id",
        "visible_consequence_fingerprint",
        "single_use_token_id"
      ],
      "single_use": true
    }
  ],
  "fact_kind_policy": {
    "protocols_per_fact_kind": 1,
    "policy_is_founder_locked": true,
    "unsupported_protocol_result": "indeterminate",
    "unsupported_assertion_standing": "evidence_only"
  },
  "proof_replay_rule": "same_bytes_same_transition_same_predecessor_same_visible_consequence_and_same_reserved_receipt_may_return_the_stored_result_but_any_new_binding_requires_new_proof_and_authority",
  "validity_rule": {
    "expression": "transaction_time + maximum_clock_skew < valid_until",
    "equality_is_valid": false,
    "server_transaction_time_required": true
  },
  "coordination_states": [
    {
      "state": "reserved",
      "steering_eligible": false,
      "meaning": "local receipt version and idempotency key reserved"
    },
    {
      "state": "external_confirmed",
      "steering_eligible": false,
      "meaning": "exact lease or conditional single-use token acquired"
    },
    {
      "state": "local_committed_pending_ack",
      "steering_eligible": false,
      "meaning": "local provisional commit exists but external finality or acknowledgement is unresolved"
    },
    {
      "state": "finalized",
      "steering_eligible": true,
      "meaning": "protocol-specific external finality and local commit both hold"
    },
    {
      "state": "aborted",
      "steering_eligible": false,
      "meaning": "transition did not become usable and any external reservation is released or expires"
    },
    {
      "state": "quarantined",
      "steering_eligible": false,
      "meaning": "reconciliation found uncertainty or mismatch and descendants are blocked"
    }
  ],
  "coordination_state_set_is_exhaustive": true,
  "allowed_edges": [
    "reserved->external_confirmed",
    "reserved->aborted",
    "reserved->quarantined",
    "external_confirmed->local_committed_pending_ack",
    "external_confirmed->aborted",
    "external_confirmed->quarantined",
    "local_committed_pending_ack->finalized",
    "local_committed_pending_ack->quarantined"
  ],
  "state_contracts": {
    "reserved": {
      "entry": "unique_local_reservation_id_idempotency_key_nonce_transition_and_reserved_receipt_version_exist",
      "exit": "bound_external_protocol_result_or_terminal_abort_or_quarantine_receipt",
      "required_receipt": "reservation_receipt"
    },
    "external_confirmed": {
      "entry": "exact_current_lease_or_single_use_token_is_bound_to_reservation_nonce_transition_receipt_and_visible_consequence",
      "exit": "local_compare_and_set_commit_or_terminal_abort_or_quarantine_receipt",
      "required_receipt": "external_confirmation_receipt"
    },
    "local_committed_pending_ack": {
      "entry": "local_provisional_commit_atomically_records_external_token_identity_and_remains_non_steering",
      "exit": "protocol_specific_external_finality_or_quarantine_receipt",
      "required_receipt": "local_provisional_commit_receipt"
    },
    "finalized": {
      "entry": "protocol_specific_external_finality_and_local_commit_are_both_proved",
      "exit": "none_terminal",
      "required_receipt": "finalized_transition_receipt"
    },
    "aborted": {
      "entry": "transition_did_not_commit_or_external_reservation_was_released_or_allowed_to_expire",
      "exit": "none_terminal",
      "required_receipt": "abort_receipt"
    },
    "quarantined": {
      "entry": "reconciliation_uncertainty_or_mismatch_blocks_transition_and_descendants",
      "exit": "none_terminal_until_separate_repair_contract",
      "required_receipt": "quarantine_receipt"
    }
  },
  "finalization_vs_acknowledgement": {
    "finalization": "authoritative_external_and_local_terminal_state",
    "acknowledgement": "delivery_evidence_only",
    "lost_ack_rule": "query_issuer_by_same_nonce_and_token_identity",
    "acknowledgement_alone_can_finalize": false
  },
  "retry_rules": {
    "reuse_idempotency_key": true,
    "reuse_transaction_nonce": true,
    "new_nonce_on_retry": false,
    "same_key_and_nonce_same_canonical_bytes": "return_same_terminal_or_current_state",
    "same_key_or_nonce_different_canonical_bytes": "reject_collision",
    "token_binding_mismatch": "reject",
    "duplicate_token_consumption": "reject"
  }
}
