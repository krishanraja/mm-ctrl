    "G25-RECONSENT-ORCHESTRATOR-R41",
    "G25-RUNTIME-CALLER-INVENTORY-R34"
  ],
  "endpoint": {
    "method": "POST",
    "authentication": "verified subject JWT only",
    "max_json_bytes": 2048,
    "cors": "configured product origins only",
    "model_calls": 0,
    "browser_operations": 1,
    "internal_sequence": [
