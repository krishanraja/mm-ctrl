  "alerts": [
    "any downstream contract mismatch",
    "any returned scope identity mismatch",
    "any uniqueness invariant failure",
    "reserved-not-created unresolved for five minutes",
    "failure rate above five percent over fifteen minutes with at least twenty attempts",
    "p95 database duration above five seconds with at least twenty attempts"
