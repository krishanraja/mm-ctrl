  "rollout": [
    "Supabase-local migration, grant, rollback and concurrency rehearsal",
    "synthetic operator-only probes",
    "one internal authenticated subject restart",
    "one explicitly consenting pilot workspace",
    "separate evidence-based decision for each additional workspace"
  ],
  "rollback": {
    "first_action": "disable server flag",
    "preserve": [
      "accepted consent reservations",
      "scope creation receipts",
      "old erasure tombstones",
      "already created new scopes",
      "pending repair standing"
    ],
    "forbidden": [
      "table drops",
      "erasure reversal",
      "consent-history edits",
      "backup restore over newer human actions"
    ]
  },
  "next_gate": "Extend whole-Brain deletion discovery to storage objects, provider receipts and non-FK identifiers while the runtime gates remain blocked by the missing container and connection-pool environment.",
  "not_authorized": [
