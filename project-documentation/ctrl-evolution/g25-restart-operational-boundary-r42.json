  "telemetry": {
    "allowed": [
      "event name",
      "release and route version",
      "bounded outcome code",
      "duration bucket",
      "retry standing",
      "keyed correlation digest"
    ],
    "forbidden": [
      "bearer token",
      "email",
      "raw user or workspace UUID",
      "request body",
      "statement text",
      "database error text",
      "Brain content",
      "old or new custody identity"
