{
  "schema_version": "ctrl.g24.predicate-authority.r80.external-program.v1",
  "module_id": "external_program",
  "authoritative_external_fact_kinds": [],
  "unsupported_external_assertion": "evidence_only_indeterminate",
  "states": ["unreserved", "reserved", "external_confirmed", "local_committed_pending_ack", "finalized", "aborted", "quarantined"],
  "transitions": [
    { "from": "unreserved", "event": "commit_local_reservation", "to": "reserved", "guard": "unique_idempotency_key_nonce_transition_and_reserved_receipt_version", "transaction": "local_serializable_reservation" },
    { "from": "reserved", "event": "acquire_bound_external_authority", "to": "external_confirmed", "guard": "active_founder_locked_fact_policy_and_exact_token_or_lease_bindings", "transaction": "external_protocol_call" },
    { "from": "reserved", "event": "reservation_cancel_or_expire", "to": "aborted", "guard": "terminal_abort_receipt", "transaction": "local_serializable_abort" },
    { "from": "external_confirmed", "event": "commit_local_provisional", "to": "local_committed_pending_ack", "guard": "first_compare_and_set_all_required_bindings", "transaction": "local_serializable_provisional_commit" },
    { "from": "external_confirmed", "event": "local_commit_failed_release_or_expire", "to": "aborted", "guard": "release_or_expiry_receipt", "transaction": "external_compensation_then_local_abort" },
    { "from": "local_committed_pending_ack", "event": "immutable_lease_still_current", "to": "finalized", "guard": "lease_protocol_finality_and_second_compare_and_set", "transaction": "local_serializable_finalization" },
    { "from": "local_committed_pending_ack", "event": "conditional_token_consumed", "to": "finalized", "guard": "consume_protocol_finality_and_second_compare_and_set", "transaction": "external_consume_then_local_serializable_finalization" },
    { "from": "local_committed_pending_ack", "event": "ack_lost_query_same_token_nonce", "to": "local_committed_pending_ack", "guard": "no_steering_while_reconciliation_pending", "transaction": "idempotent_external_status_query" },
    { "from": "reserved", "event": "authority_mismatch", "to": "quarantined", "guard": "quarantine_receipt", "transaction": "local_serializable_quarantine" },
    { "from": "external_confirmed", "event": "authority_mismatch", "to": "quarantined", "guard": "quarantine_receipt", "transaction": "local_serializable_quarantine" },
    { "from": "local_committed_pending_ack", "event": "reconciliation_failed", "to": "quarantined", "guard": "quarantine_receipt_and_descendant_block", "transaction": "local_serializable_quarantine" }
  ],
  "first_compare_and_set": ["transition_receipt_version", "predecessor_version", "source_heads", "set_seals", "revocation_epochs", "human_authority_receipt_version", "external_token_or_lease_identity", "idempotency_key", "transaction_nonce", "visible_consequence_fingerprint"],
  "second_compare_and_set": ["same_provisional_transition_version", "same_reserved_receipt_version", "same_external_token_or_lease_identity", "same_idempotency_key", "same_transaction_nonce", "same_visible_consequence_fingerprint", "same_or_stricter_validity_boundary", "protocol_specific_external_finality_evidence"],
  "protocol_finality": {
    "immutable_authority_lease": "same_lease_revision_key_policy_fact_epoch_and_strict_validity_boundary_current_at_second_compare_and_set",
    "online_conditional_verify_and_consume": "same_single_use_token_consumed_for_same_reservation_nonce_transition_receipt_and_consequence_before_second_compare_and_set"
  },
  "strict_validity": "server_transaction_time + maximum_clock_skew_seconds < valid_until",
  "retry": { "same_key_nonce_and_bytes": "return_same_state", "same_key_or_nonce_changed_bytes": "reject_collision", "new_nonce_on_retry": false },
  "steering_state": "finalized",
  "terminal_states": ["finalized", "aborted", "quarantined"],
  "terminal_receipt_required": true
}
